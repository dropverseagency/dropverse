# DropVerse environment variables
# Copy to .env.local (local dev) and add to Vercel (Production & Preview).

# Create a Supabase project at https://supabase.com, then run
# `supabase/schema.sql` and the migration files in the SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Paddle Billing
# Server-only API key; never expose this in NEXT_PUBLIC_ code.
PADDLE_API_KEY=YOUR_PADDLE_API_KEY
# Paddle notification destination secret used by /api/paddle/webhook.
PADDLE_WEBHOOK_SECRET=YOUR_PADDLE_WEBHOOK_SECRET
# Public runtime environment: production or sandbox.
NEXT_PUBLIC_PADDLE_ENV=production
# Public Paddle client-side token required for the overlay checkout.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=YOUR_PADDLE_CLIENT_TOKEN
