# Supabase — public browser values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Dodo Payments — server-only API credential
DODO_PAYMENTS_API_KEY=YOUR_DODO_PAYMENTS_API_KEY
# Use test for test.dodopayments.com or live for live.dodopayments.com
DODO_PAYMENTS_ENV=live
# Server-only secret copied from Dodo Developer > Webhooks
DODO_PAYMENTS_WEBHOOK_SECRET=YOUR_DODO_PAYMENTS_WEBHOOK_SECRET

# Dodo product IDs from the Dodo dashboard
DODO_SAMPLE_PRODUCT_ID=SET_IN_DODO_DASHBOARD
DODO_AGENCY_PRODUCT_ID=SET_IN_DODO_DASHBOARD
DODO_PRO_PRODUCT_ID=SET_IN_DODO_DASHBOARD

# Public site URL used for Dodo return/cancel URLs
NEXT_PUBLIC_SITE_URL=https://dropverse.js.org
