# Supabase — public browser values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key

# Supabase — server only (never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Public site URL (redirects, absolute links)
NEXT_PUBLIC_SITE_URL=https://dropverse10v.vercel.app

# SpaceRemit — local payments
NEXT_PUBLIC_SPACEREMIT_PUBLIC_KEY=
SPACEREMIT_PUBLIC_KEY=
SPACEREMIT_PRIVATE_KEY=

# Optional: admin user id fallback (primary check is profiles.role = admin)
ADMIN_USER_ID=

# Optional: Upstash Redis rate limiting (fail-open if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Cloudflare Turnstile (skipped if unset)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Social sign-in (buttons show unless set to "false")
# Enable providers in Supabase Dashboard → Authentication → Providers
# Redirect URL: {NEXT_PUBLIC_SITE_URL}/auth/callback
NEXT_PUBLIC_GOOGLE_SIGN_IN=true
NEXT_PUBLIC_APPLE_SIGN_IN=true

# PayPal Checkout (Sandbox or Live client id)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Whop — server-only checkout and signed webhook integration
WHOP_COMPANY_API_KEY=
WHOP_API_KEY=
WHOP_SANDBOX=false
WHOP_COMPANY_ID=
WHOP_PROJECT_PRODUCT_ID=
WHOP_LEAD_PACK_PRODUCT_ID=
WHOP_WEBHOOK_SECRET=
# Subscription plans (public IDs only; create the matching plans in Whop first)
NEXT_PUBLIC_WHOP_AGENCY_MONTHLY_PLAN_ID=
NEXT_PUBLIC_WHOP_AGENCY_PRO_MONTHLY_PLAN_ID=
