# Supabase — public browser values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key

# Supabase — server only (never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Public site URL (redirects, absolute links)
NEXT_PUBLIC_SITE_URL=https://dropverse10v.vercel.app

# SpaceRemit — local payments
NEXT_PUBLIC_SPACEREMIT_PUBLIC_KEY=
SPACEREMIT_PUBLIC_KEY=
SPACEREMIT_PRIVATE_KEY=

# Optional: admin user id fallback (primary check is profiles.role = admin)
ADMIN_USER_ID=

# Optional: Upstash Redis rate limiting (fail-open if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Cloudflare Turnstile (skipped if unset)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: show Google sign-in button
NEXT_PUBLIC_GOOGLE_SIGN_IN=false

# Resend (email) — optional; skips gracefully if unset
RESEND_API_KEY=
RESEND_FROM_EMAIL=DropVerse <onboarding@resend.dev>

# Telegram admin alerts — optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Daily cron protection
CRON_SECRET=
